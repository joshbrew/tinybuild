{
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ../../tinybuild/bin/global.js",
    "build": "node ../../tinybuild/bin/global.js build",
    "config": "node ../../tinybuild/bin/global.js config",
    "electron:dev": "node ../../tinybuild/bin/global.js desktop=electron --devtools --inspect=9229",
    "electron:watch": "node ../../tinybuild/bin/global.js desktop=electron --profile electronDebug --devtools",
    "tauri:dev": "node ../../tinybuild/bin/global.js desktop=tauri",
    "electron:release": "node ../../tinybuild/bin/global.js build --profile electronRelease",
    "tauri:release": "node ../../tinybuild/bin/global.js build --profile tauriRelease"
  }
}
