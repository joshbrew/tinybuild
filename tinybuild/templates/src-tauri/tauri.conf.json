{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tinybuild App",
  "version": "0.0.0",
  "identifier": "com.tinybuild.app",
  "build": {
    "frontendDist": "./tauri_dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tinybuild App",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
